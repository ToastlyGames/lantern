# Copy these into Vercel → Project → Settings → Environment Variables. Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # Supabase → Project Settings → API → service_role (secret!)
SESSION_SECRET=paste-64-random-characters-here          # signs login cookies; generate one, keep it secret
APP_DOMAIN=lanternhold.vercel.app                       # the exact domain players use (no https://)
# RPC_URL=https://rpc.mainnet.chain.robinhood.com       # optional: your own Robinhood Chain RPC for smart-wallet signatures
# TOKEN_CA=0x...                                        # official token contract address, shown on the Bulletin + wiki (set at launch, then redeploy)
# TOKEN_SYMBOL=LANT                                     # optional ticker shown with it
# REWARDS_ON=1                                          # token rewards: players earn from the pool (run supabase/rewards.sql first)
# CLAIM_CONTRACT=0x...                                  # the rewards vault (deploy with /tools/vault.html)
# CLAIM_SIGNER_KEY=0x...                                # private key of a signing-only wallet (Sensitive!); its address goes into the vault
# CLAIM_MIN=100                                         # smallest claim, in tokens
# CLAIM_MIN_LEVEL=5                                     # combat level needed to claim
# FOUNDERS_CONTRACT=0x...                               # Founder's Lantern NFT (deploy with /tools/founders.html; run supabase/founders.sql first)
# FOUNDERS_SIGNER_KEY=0x...                             # optional (Sensitive!): signs mint vouchers; defaults to CLAIM_SIGNER_KEY
# FOUNDERS_WL=1000                                      # whitelist: the first N heroes
# FOUNDERS_MIN_LEVEL=10                                 # ...who reach this combat level
